generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  HR_ADMIN
  MANAGER
  EMPLOYEE
}

enum AccountStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

enum MetricType {
  QUANTITATIVE
  QUALITATIVE
}

enum ReviewStatus {
  GOAL_DRAFT
  GOAL_PENDING_APPROVAL
  GOAL_REVISION_REQUIRED
  GOAL_APPROVED
  SELF_REVIEW_SUBMITTED
  REVIEW_REVISION_REQUIRED
  MANAGER_APPROVED
  CALIBRATION_LOCKED
  PUBLISHED
}

enum NineBoxCell {
  STAR_HIGH_PERFORMER
  HIGH_IMPACT_GROWTH
  HIGH_POTENTIAL_EMERGING
  CONSISTENT_CONTRIBUTOR
  CORE_PERFORMER
  DEVELOPING_TALENT
  EFFECTIVE_SPECIALIST
  INCONSISTENT_PERFORMER
  NEEDS_ACTION_LOW_PERFORMER
}

model User {
  id            String        @id @default(cuid())
  employeeCode  String        @unique
  email         String        @unique
  passwordHash  String
  name          String
  nameTh        String?
  title         String
  department    String
  role          UserRole      @default(EMPLOYEE)
  accountStatus AccountStatus @default(PENDING_APPROVAL)
  managerId     String?
  manager       User?         @relation("ManagerReports", fields: [managerId], references: [id])
  directReports User[]        @relation("ManagerReports")

  goals           Goal[]
  employeeReviews Review[]   @relation("EmployeeReviews")
  managedReviews  Review[]   @relation("ManagerReviews")
  auditLogs       AuditLog[] @relation("ActorAuditLogs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id            String   @id @default(cuid())
  role          UserRole
  permissionKey String
  allowed       Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@unique([role, permissionKey])
}

model ReviewCycle {
  id                  String   @id @default(cuid())
  name                String
  nameTh              String?
  period              String
  whatWeight          Int      @default(60)
  howWeight           Int      @default(40)
  selfDeadline        DateTime
  managerDeadline     DateTime
  isGracePeriodActive Boolean  @default(false)
  isLocked            Boolean  @default(false)
  isActive            Boolean  @default(true)
  rubricConfig        Json?

  goals     Goal[]
  reviews   Review[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Goal {
  id          String      @id @default(cuid())
  cycleId     String
  cycle       ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    User        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title       String
  titleTh     String
  metricType  MetricType  @default(QUANTITATIVE)
  targetValue String      @default("100")
  unit        String      @default("%")
  metric      String
  weight      Int
  multiplier  Float       @default(1.0)
  dueDate     DateTime?
  actualValue String?
  progressPct Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id                   String       @id @default(cuid())
  cycleId              String
  cycle                ReviewCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             User         @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  managerId            String?
  manager              User?        @relation("ManagerReviews", fields: [managerId], references: [id])
  status               ReviewStatus @default(GOAL_DRAFT)
  revisionRound        Int          @default(1)
  selfPayload          Json?
  managerPayload       Json?
  commentHistory       Json?
  whatPct              Float?
  whatScore            Float?
  howScore             Float?
  overallScore         Float?
  nineBoxCell          NineBoxCell?
  selfSubmittedAt      DateTime?
  managerSubmittedAt   DateTime?
  calibratedAt         DateTime?
  extendedDeadline     DateTime?
  escalatedToSkipLevel Boolean      @default(false)
  lastNudgedAt         DateTime?
  publishedAt          DateTime?

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, employeeId])
}

model AuditLog {
  id        String       @id @default(cuid())
  cycleId   String?
  cycle     ReviewCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  reviewId  String?
  review    Review?      @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  actorId   String
  actor     User         @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  reason    String?
  metadata  Json?
  createdAt DateTime     @default(now())
}
